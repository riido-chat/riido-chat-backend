{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Private cache-path failed stage trace",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion", "group", "runId", "goldenVersion", "appBuildCommit",
    "itemId", "turnNo", "failureStage", "failureCode", "trace"
  ],
  "properties": {
    "schemaVersion": {"const": 1},
    "group": {"const": "cache-path-failed-trace"},
    "runId": {"type": "string", "minLength": 1},
    "goldenVersion": {"type": "string", "minLength": 1},
    "appBuildCommit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "itemId": {"type": "string", "minLength": 1},
    "turnNo": {"type": "integer", "minimum": 1},
    "failureStage": {"type": "string"},
    "failureCode": {"type": ["string", "null"], "pattern": "^[A-Za-z][A-Za-z0-9_]{0,99}$"},
    "trace": {
      "type": "object", "additionalProperties": false,
      "required": ["traceId", "target", "events"],
      "properties": {
        "traceId": {"type": "string", "format": "uuid"},
        "target": {"enum": ["FULL_ANSWER", "CACHE_DECISION"]},
        "events": {
          "type": "array", "minItems": 1,
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["stage", "outcome", "durationMs", "detailCode"],
            "properties": {
              "stage": {"type": "string"},
              "outcome": {"enum": ["SUCCEEDED", "FAILED", "SKIPPED"]},
              "durationMs": {"type": "integer", "minimum": 0},
              "detailCode": {"type": ["string", "null"], "pattern": "^[A-Za-z][A-Za-z0-9_]{0,99}$"}
            }
          }
        }
      }
    }
  }
}
