{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Private cache-path failed run ledger entry",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "group", "runId", "status", "failureStage", "errorType"],
  "properties": {
    "schemaVersion": {"const": 1},
    "group": {"const": "cache-path-failed-run"},
    "runId": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,99}$"},
    "status": {"enum": ["FAILED", "FINALIZATION_INCOMPLETE"]},
    "failureStage": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_]{0,99}$"},
    "errorType": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_]{0,99}$"},
    "itemId": {"type": "string", "minLength": 1},
    "turnNo": {"type": "integer", "minimum": 1},
    "trace": {"$ref": "#/$defs/trace"}
  },
  "allOf": [
    {"if": {"required": ["itemId"]}, "then": {"required": ["turnNo"]}},
    {"if": {"required": ["turnNo"]}, "then": {"required": ["itemId"]}}
  ],
  "$defs": {
    "trace": {
      "type": "object",
      "additionalProperties": false,
      "required": ["traceId", "target", "events"],
      "properties": {
        "traceId": {"type": "string", "format": "uuid"},
        "target": {"enum": ["FULL_ANSWER", "CACHE_DECISION"]},
        "events": {"type": "array", "items": {"$ref": "#/$defs/event"}}
      }
    },
    "event": {
      "type": "object",
      "additionalProperties": false,
      "required": ["stage", "outcome", "durationMs", "detailCode"],
      "properties": {
        "stage": {"type": "string"},
        "outcome": {"enum": ["SUCCEEDED", "FAILED", "SKIPPED"]},
        "durationMs": {"type": "integer", "minimum": 0},
        "detailCode": {"type": ["string", "null"], "pattern": "^[A-Za-z][A-Za-z0-9_]{0,99}$"}
      }
    }
  }
}
