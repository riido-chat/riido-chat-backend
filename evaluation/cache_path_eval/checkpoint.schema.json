{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Private cache-path turn checkpoint",
  "type": "object",
  "additionalProperties": false,
  "required": ["itemId", "turnNo", "outcome", "nextStage", "latencyMs", "modelCalls", "embeddingCalls", "trace"],
  "properties": {
    "itemId": {"type": "string", "minLength": 1},
    "turnNo": {"type": "integer", "minimum": 1},
    "outcome": {"enum": ["SERVED", "SHADOW", "GROUP_DISABLED", "REJECTED", "SKIPPED", "FAILED"]},
    "nextStage": {"enum": ["PASS", "FAIL", "NOT_APPLICABLE"]},
    "latencyMs": {"type": "integer", "minimum": 0},
    "modelCalls": {"type": "integer", "minimum": 0},
    "embeddingCalls": {"type": "integer", "minimum": 0},
    "evidence": {"$ref": "#/$defs/evidence"},
    "trace": {"$ref": "#/$defs/trace"}
  },
  "$defs": {
    "evidence": {
      "type": "object", "additionalProperties": false,
      "required": ["seed", "retrievalCandidates", "subproblemCandidates", "selectedSubproblemId", "selectedCanonicalAnswerId", "gateRejectionReasons", "exactSourceClassificationId", "exactFallthroughReasons", "modelCalls"],
      "properties": {
        "seed": {"$ref": "#/$defs/safeTokenOrNull"},
        "retrievalCandidates": {"type": "array", "items": {"$ref": "#/$defs/retrievalCandidate"}},
        "subproblemCandidates": {"type": "array", "items": {"$ref": "#/$defs/subproblemCandidate"}},
        "selectedSubproblemId": {"$ref": "#/$defs/safeTokenOrNull"},
        "selectedCanonicalAnswerId": {"$ref": "#/$defs/safeTokenOrNull"},
        "gateRejectionReasons": {"type": "array", "items": {"$ref": "#/$defs/safeToken"}},
        "exactSourceClassificationId": {"type": ["integer", "null"], "minimum": 1},
        "exactFallthroughReasons": {"type": "array", "items": {"$ref": "#/$defs/safeToken"}},
        "modelCalls": {"type": "array", "items": {"$ref": "#/$defs/modelCallEvidence"}}
      }
    },
    "retrievalCandidate": {
      "type": "object", "additionalProperties": false,
      "required": ["chunkId", "documentVersionId", "indexVersionId", "rank"],
      "properties": {
        "chunkId": {"type": "integer", "minimum": 1},
        "documentVersionId": {"type": "integer", "minimum": 1},
        "indexVersionId": {"type": "integer", "minimum": 1},
        "rank": {"type": "integer", "minimum": 1}
      }
    },
    "subproblemCandidate": {
      "type": "object", "additionalProperties": false,
      "required": ["key", "subproblemId", "version", "canonicalAnswerId"],
      "properties": {
        "key": {"$ref": "#/$defs/safeToken"},
        "subproblemId": {"$ref": "#/$defs/safeToken"},
        "version": {"type": "integer", "minimum": 1},
        "canonicalAnswerId": {"$ref": "#/$defs/safeTokenOrNull"}
      }
    },
    "modelCallEvidence": {
      "type": "object", "additionalProperties": false,
      "required": ["purpose", "provider", "modelName", "promptVersion", "succeeded", "latencyMs", "retryCount", "inputTokens", "outputTokens", "cachedInputTokens", "reasoningTokens"],
      "properties": {
        "purpose": {"enum": ["QUERY_REWRITE", "QUERY_EMBEDDING", "QUESTION_CLASSIFICATION"]},
        "provider": {"$ref": "#/$defs/safeToken"},
        "modelName": {"$ref": "#/$defs/safeToken"},
        "promptVersion": {"$ref": "#/$defs/safeTokenOrNull"},
        "succeeded": {"type": "boolean"},
        "latencyMs": {"type": "integer", "minimum": 0},
        "retryCount": {"type": "integer", "minimum": 0},
        "inputTokens": {"$ref": "#/$defs/nonnegativeIntegerOrNull"},
        "outputTokens": {"$ref": "#/$defs/nonnegativeIntegerOrNull"},
        "cachedInputTokens": {"$ref": "#/$defs/nonnegativeIntegerOrNull"},
        "reasoningTokens": {"$ref": "#/$defs/nonnegativeIntegerOrNull"}
      }
    },
    "safeToken": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,199}$"},
    "safeTokenOrNull": {"type": ["string", "null"], "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,199}$"},
    "nonnegativeIntegerOrNull": {"type": ["integer", "null"], "minimum": 0},
    "trace": {
      "type": "object",
      "additionalProperties": false,
      "required": ["traceId", "target", "events"],
      "properties": {
        "traceId": {"type": "string", "format": "uuid"},
        "target": {"enum": ["FULL_ANSWER", "CACHE_DECISION"]},
        "events": {"type": "array", "items": {"$ref": "#/$defs/event"}}
      }
    },
    "event": {
      "type": "object",
      "additionalProperties": false,
      "required": ["stage", "outcome", "durationMs", "detailCode"],
      "properties": {
        "stage": {"type": "string"},
        "outcome": {"enum": ["SUCCEEDED", "FAILED", "SKIPPED"]},
        "durationMs": {"type": "integer", "minimum": 0},
        "detailCode": {"type": ["string", "null"], "pattern": "^[A-Za-z][A-Za-z0-9_]{0,99}$"}
      }
    }
  }
}
