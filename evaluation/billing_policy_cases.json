            ["각각", "각 워크스페이스", "워크스페이스마다"]
          ],
          "minimumCitationCount": 1,
          "expectedCitationDocumentTitlesAny": ["구독 및 결제"]
        }
      ]
    },
    {
      "id": "BP007",
      "mode": "NEW_CONVERSATION",
      "description": "비활성화 후 남은 유료 시트 재사용",
      "turns": [
        {
          "question": "결제한 멤버를 비활성화하면 남은 자리를 다른 사람 초대할 때 다시 쓸 수 있어?",
          "expectedStatus": "COMPLETED",
          "expectedPlanningStatus": "ANSWERABLE",
          "expectedAnswerConceptGroups": [
            ["유료 시트", "시트"],
            ["남"],
            ["새 사용자", "다른 사람"],
            ["초대"]
          ],
          "minimumCitationCount": 1,
          "expectedCitationDocumentTitlesAny": ["구독 및 결제"]
        }
      ]
    },
    {
      "id": "BP008",
      "mode": "NEW_CONVERSATION",
      "description": "월별 결제일 산정 기준",
      "turns": [
        {
          "question": "3월 10일에 월간 결제를 시작했다면 다음 결제는 언제야?",
          "expectedStatus": "COMPLETED",
          "expectedPlanningStatus": "ANSWERABLE",
          "expectedAnswerConceptGroups": [
            ["매달 10일", "4월 10일"]
