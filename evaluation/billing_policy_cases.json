{
  "version": "billing-policy-v1",
  "description": "구독 및 결제 문서의 사용자 시트 기준과 멤버 변동 시 청구 정책을 평가한다.",
  "recommendedRepeat": 3,
  "cases": [
    {
      "id": "BP001",
      "mode": "NEW_CONVERSATION",
      "description": "사용자 추가 시 요금 증가 여부",
      "turns": [
        {
          "question": "사람이 추가되면 요금이 더 나와?",
          "expectedStatus": "COMPLETED",
          "expectedPlanningStatus": "ANSWERABLE",
          "expectedAnswerConceptGroups": [
            ["사용자", "시트"],
            ["추가"],
            ["요금", "비용"]
          ],
          "minimumCitationCount": 1,
          "expectedCitationDocumentTitlesAny": ["구독 및 결제"]
        }
      ]
    },
    {
      "id": "BP002",
      "mode": "NEW_CONVERSATION",
      "description": "결제 기간 중 추가 사용자의 즉시 결제 여부",
      "turns": [
        {
          "question": "결제 기간 중에 사용자를 추가하면 그 자리에서 바로 결제돼?",
          "expectedStatus": "COMPLETED",
          "expectedPlanningStatus": "ANSWERABLE",
          "expectedAnswerConceptGroups": [
            ["즉시 결제되지", "바로 결제되지", "즉시 청구되지", "바로 청구되지"],
            ["다음 결제일"],
            ["소급"]
          ],
          "minimumCitationCount": 1,
          "expectedCitationDocumentTitlesAny": ["구독 및 결제"]
        }
      ]
    },
    {
      "id": "BP003",
      "mode": "NEW_CONVERSATION",
      "description": "월간 요금제 중간 합류자의 청구 방식",
      "turns": [
        {
          "question": "월간 요금제를 쓰다가 중간에 팀원이 합류하면 비용은 언제 어떻게 청구해?",
          "expectedStatus": "COMPLETED",
          "expectedPlanningStatus": "ANSWERABLE",
          "expectedAnswerConceptGroups": [
            ["다음 결제일"],
            ["일할", "사용 기간만큼"],
            ["소급"]
          ],
          "minimumCitationCount": 1,
          "expectedCitationDocumentTitlesAny": ["구독 및 결제"]
        }
      ]
    },
    {
      "id": "BP004",
      "mode": "NEW_CONVERSATION",
      "description": "연간 요금제의 추가 인원 청구 시점과 비용",
      "turns": [
        {
          "question": "연간 결제 중에 멤버를 추가하면 언제 어떤 비용이 청구돼?",
          "expectedStatus": "COMPLETED",
          "expectedPlanningStatus": "ANSWERABLE",
          "expectedAnswerConceptGroups": [
            ["다음 달"],
            ["잔여기간", "잔여 기간", "남은 기간"],
